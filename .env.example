# ---- Site and indexing ----
# Production origin, e.g. https://permitguys.ca. Leave unset on previews to keep them out of search.
NEXT_PUBLIC_SITE_URL=
# Set to true on staging to keep it out of search even with a site URL.
SITE_NOINDEX=
# Search engine ownership tokens (meta tag method). See docs/SEARCH_CONSOLE.md.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Inquiry delivery (configure at least one; see docs/INQUIRY.md) ----
# Email through Resend. All three are needed. The sender must use a domain verified in Resend.
RESEND_API_KEY=
INQUIRY_EMAIL_FROM=
# Comma-separated recipients.
INQUIRY_EMAIL_TO=
# JSON webhook for a CRM or automation tool (https only). Receives inquiry-form
# leads and the assistant's requests (with "source": "website-assistant", the
# scope, the conversation and the visit summary). LEAD_WEBHOOK_URL is accepted
# as another name for it; set one, not both.
INQUIRY_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
# Optional HMAC secret; the webhook body is signed in the X-PermitGuys-Signature header.
INQUIRY_WEBHOOK_SECRET=
LEAD_WEBHOOK_SECRET=

# ---- Spam protection (optional) ----
# Cloudflare Turnstile. Set both to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Defaults: 5 submissions per IP per 10 minutes, forms faster than 3 seconds are rejected.
INQUIRY_RATE_LIMIT_MAX=
INQUIRY_RATE_LIMIT_WINDOW_MINUTES=
INQUIRY_MIN_FILL_SECONDS=

# ---- Google reviews and map (optional; see docs/REVIEWS.md) ----
# Places API (New) key and the business's place ID. Set both to show live
# rating, count and recent reviews; without them the site shows the rating
# recorded in src/content/site.ts. Server-side only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Maps Embed API key (restrict it to your domain). Without it the map uses the standard embed link.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Mapbox public token (pk.…; restrict it to the site's URLs in the Mapbox account) for
# the projects map. Read at build time: set it in Vercel and redeploy. Without it the
# map's frame shows the projects as drawn dots.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---- Permit strategist assistant (optional; see docs/CHAT.md) ----
# Anthropic API key, used through the Vercel AI SDK (@ai-sdk/anthropic). The
# assistant appears on the site only when this is set at build time, so
# redeploy after adding it. Without it the widget is not rendered and
# /api/chat answers 503. Server-side only.
ANTHROPIC_API_KEY=
# Claude model for the assistant. Defaults to claude-opus-5-5.
CHAT_MODEL=
# Defaults: 30 messages per visitor IP per 10 minutes.
CHAT_RATE_LIMIT_MAX=
CHAT_RATE_LIMIT_WINDOW_MINUTES=

# ---- Assistant lead notifications (src/lib/ai/notify-owners.ts; see docs/CHAT.md) ----
# Every assistant conversation reaches the team: [CLOSED LEAD] emails when a
# visitor sends the closing card or types a phone number or email in the chat
# (the card's visitor also gets a confirmation email), and
# [POSSIBLE LEAD — CHAT SUMMARY] emails when a visitor chats and leaves.
# Uses RESEND_API_KEY above. Each falls back to the inquiry form's setting:
# RESEND_FROM_EMAIL -> INQUIRY_EMAIL_FROM, LEAD_NOTIFICATION_EMAIL -> INQUIRY_EMAIL_TO.
RESEND_FROM_EMAIL=
# Comma-separated team inbox(es) for assistant leads.
LEAD_NOTIFICATION_EMAIL=
# LEAD_WEBHOOK_URL (above) also receives both kinds as JSON with
# "leadStatus": "closed_handoff" or "possible_lead_abandoned" and the sessionId.
# With no email and no webhook set, nothing is sent and the server logs say so.
